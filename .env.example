# Environment configuration — English-Language Assessment & Diagnostic Pilot
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and must never be
# committed. In production these variables are set in the host's dashboard instead (ARCHITECTURE
# Section 16); a missing `.env` is expected there.
#
# A variable marked REQUIRED is validated at startup by `src/config/env.ts` — the process exits
# with a clear error before it binds a port rather than failing later on a live request.

# ---------------------------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------------------------

# development | test | production
# Defaults to development when unset.
NODE_ENV=development

# Port the Express process listens on. The host sets this in production; 3000 is the local default.
PORT=3000

# ---------------------------------------------------------------------------------------------
# Database (REQUIRED)
# ---------------------------------------------------------------------------------------------

# Application database. Supabase Postgres in production, local Postgres for development.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lexora_dev

# Test database used only by the integration test suite (T1.2.2). It must be a SEPARATE database
# from DATABASE_URL — the suite migrates and truncates it between tests, so pointing it at the
# application database would destroy real data. Required to run `npm test`.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/lexora_test

# ---------------------------------------------------------------------------------------------
# Sessions (REQUIRED)
# ---------------------------------------------------------------------------------------------

# Signs both session cookies (staff and student). Minimum 32 characters.
# Generate one with:  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# Never commit a real value.
SESSION_SECRET=replace-me-with-a-random-32-plus-character-string

# ---------------------------------------------------------------------------------------------
# AI provider (REQUIRED outside the test environment)
# ---------------------------------------------------------------------------------------------

# Server-side only. Read exclusively inside `src/ai/OllamaProvider.ts`; never sent to the client,
# never written to a log line or an API response (ARCHITECTURE Section 13).
OLLAMA_API_KEY=replace-me

# Ollama Cloud API endpoint.
OLLAMA_BASE_URL=https://ollama.com/api
